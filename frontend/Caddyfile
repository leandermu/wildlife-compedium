:80 {
	root * /srv
	encode zstd gzip

	# Dieselbe Aufgabe wie der Dev-Proxy in vite.config.ts: die App spricht
	# mit einem einzigen Origin – kein CORS, keine API-URL zur Bauzeit.
	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /media/* {
		header Cache-Control "public, max-age=2592000"
		reverse_proxy backend:8000
	}

	# Vite hasht die Dateinamen, also darf hart gecacht werden.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# React Router besitzt das Routing; unbekannte Pfade liefern die SPA-Hülle.
	handle {
		try_files {path} /index.html
		file_server
	}
}
